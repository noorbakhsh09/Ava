{
  "name": "ava-agent",
  "version": "1.1.0",
  "private": true,
  "description": "Desktop control plane for a Telegram and Codex coding agent",
  "license": "MIT",
  "keywords": [
    "electron",
    "telegram-bot",
    "codex",
    "coding-agent",
    "prisma",
    "postgresql"
  ],
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "bun run typecheck && electron-vite build",
    "dist:mac": "bun run build && bash scripts/package-macos.sh",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "bun test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/node": "^1.4.5",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.29",
    "grammy": "^1.45.1",
    "lucide-react": "^1.30.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.3.0",
    "electron-vite": "^5.0.0",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
