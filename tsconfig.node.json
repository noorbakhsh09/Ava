{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["electron.vite.config.ts", "prisma.config.ts", "src/main/**/*.ts", "src/preload/**/*.ts", "src/generated/**/*.ts", "tests/**/*.ts"]
}
